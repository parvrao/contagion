# Required: powers search planning, labeling, the open-web sweep and the Claude probes.
ANTHROPIC_API_KEY=
# CONTAGION_MODEL=claude-sonnet-4-5          # change if this model name is retired
# ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305

# Optional AI engines (each one adds a column to the AI engines matrix)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_WEB_TOOL=web_search                  # try web_search_preview if the API rejects it
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Optional: Profound citation cross-reference
PROFOUND_API_KEY=
PROFOUND_CATEGORY_ID=

# Optional sources
REDDIT_CLIENT_ID=                            # app-only OAuth; public JSON is often blocked without it
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Counter mode: Shopify (Dev Dashboard app, client credentials grant; token auto-refreshes every 24 h)
SHOPIFY_STORE=                               # yourstore.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ACCESS_TOKEN=                      # legacy shpat_ token also works
# SHOPIFY_API_VERSION=2026-07
# SHOPIFY_VELOCITY_DAYS=28

# Set before exposing the app anywhere public
CONTAGION_ACCESS_TOKEN=
# CONTAGION_DATA_DIR=./data
# CONTAGION_LLM_CONCURRENCY=10

# Watch mode
# SLACK_WEBHOOK_URL=                        # internal team alerts (incoming webhook); nothing external is ever posted
# CONTAGION_POLL_SECONDS=90
# CONTAGION_SWEEP_EVERY=10                  # Claude open-web sweep every N cycles (costs credits)
# CONTAGION_YOUTUBE_EVERY=10                # YouTube search every N cycles (100 quota units each)
# CONTAGION_AUTO_PLAYBOOK_SCORE=45
# GEMINI_MODEL=gemini-flash-latest
